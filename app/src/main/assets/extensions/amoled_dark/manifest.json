{
  "manifest_version": 2,
  "name": "Sideraven AMOLED Dark Web",
  "description": "True #000000 AMOLED dark theme for all webpages in Sideraven. The CSS is injected by amoled_dark.js only when prefers-color-scheme is dark, so a theme change applies live without an app restart.",
  "version": "1.1.1",
  "browser_specific_settings": {
    "gecko_android": {},
    "gecko": {
      "id": "amoled-dark@sideraven.org"
    }
  },
  "permissions": [
    "<all_urls>",
    "tabs",
    "internal:privateBrowsingAllowed"
  ],
  "web_accessible_resources": [
    "amoled_dark.css"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>",
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "amoled_dark.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
